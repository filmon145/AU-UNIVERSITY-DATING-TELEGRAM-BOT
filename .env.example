# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_USER_ID=your_telegram_numeric_id

# Database Configuration (PostgreSQL / Supabase / Neon / Local)
# Example Supabase: postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# Example Local: postgresql://postgres:password@localhost:5432/au_dating_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/au_dating_db

# SSL for Database (auto | require | disable)
# Defaults to disable for localhost, require for remote/Supabase
DATABASE_SSL=auto

# Channel Verification
# Set CHECK_CHANNEL=true if you want to require users to join a channel before registering.
# Note: The bot MUST be added as an Administrator to this channel!
CHECK_CHANNEL=false
CHANNEL_USERNAME=@AmboU_confession

# Server & Deployment Configuration
PORT=8080

# Webhook vs Polling:
# Leave RENDER_URL empty for local development to run in POLLING mode.
# Set RENDER_URL (e.g. https://your-service.onrender.com) to run in WEBHOOK mode.
RENDER_URL=
